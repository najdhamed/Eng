{
  "name": "darbak",
  "version": "1.2.0",
  "private": true,
  "description": "Darbak (دربك) — an accessible, bilingual indoor wayfinding web app for hospitals with Saudi-Arabic voice guidance, turn-by-turn routing and QR-sign relocation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "voice:generate": "vite-node scripts/generate-voice.ts"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "5.3.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.9.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.74.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
